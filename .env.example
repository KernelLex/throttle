# ─────────────────────────────────────────────────────────────────────────────
# Throttle — environment template
#
#   cp .env.example .env
#
# Every variable is validated by Zod in apps/api/src/config.ts at boot. A missing or
# malformed required value CRASHES THE PROCESS rather than defaulting silently —
# a scheduler that quietly falls back to a wrong rate limit is worse than one that
# refuses to start.
#
# Values marked [SECRET] must never be committed. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
LOG_LEVEL=debug

# Which role this process runs as: api | worker | both
# "both" is convenient for local dev; run them separately in production so the API
# can be restarted without interrupting in-flight sends.
ROLE=both

# Public URL of the API, used to build OAuth redirect URIs. Must match exactly what
# is registered in the Google and Slack app consoles.
API_BASE_URL=http://localhost:4000

# Public URL of the frontend. Used for post-login redirects and the CORS allowlist.
WEB_BASE_URL=http://localhost:5173

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=throttle
POSTGRES_PASSWORD=throttle_dev_password
POSTGRES_DB=throttle
POSTGRES_PORT=5432
DATABASE_URL=postgresql://throttle:throttle_dev_password@localhost:5432/throttle?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=throttle-emails
# When false, the app starts and runs with search degraded to a Postgres LIKE query
# instead of refusing to boot. Elasticsearch is a derived store, never the source
# of truth, so it must never be a hard startup dependency.
ELASTICSEARCH_REQUIRED=false

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS  [SECRET]
#
# Generate each with:  openssl rand -hex 32
# (Windows/PowerShell:  -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })  )
#
# ENCRYPTION_KEY must be EXACTLY 64 hex characters = 32 bytes for AES-256-GCM.
# It encrypts SMTP passwords and Slack tokens at rest. Rotating it without
# re-encrypting existing rows makes those rows unreadable — see docs/04-SECURITY.md.
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_a_DIFFERENT_openssl_rand_hex_32
ENCRYPTION_KEY=change_me_exactly_64_hex_characters_0000000000000000000000000000
COOKIE_SECRET=change_me_openssl_rand_hex_32

# Access tokens are short-lived because they cannot be revoked; refresh tokens are
# long-lived but ARE revocable and are rotated on every use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Google OAuth  [SECRET] ───────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Application type: Web application
# Authorised redirect URI must be EXACTLY:  http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict sign-in to one Google Workspace domain, e.g. reachinbox.ai
# Leave blank to allow any Google account.
GOOGLE_ALLOWED_HOSTED_DOMAIN=

# ── Slack OAuth  [SECRET] ────────────────────────────────────────────────────
# api.slack.com/apps → Create New App → OAuth & Permissions
# Bot token scopes needed:  incoming-webhook, chat:write
# Redirect URL must be EXACTLY:  http://localhost:4000/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Found under Basic Information → App Credentials. Used to verify inbound requests.
SLACK_SIGNING_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SCHEDULER TUNING
#
# These are the values the brief requires to be configurable. Nothing below is
# hardcoded anywhere in the source. Per-sender values in the database override
# these defaults; these apply when a sender has no explicit setting.
# ─────────────────────────────────────────────────────────────────────────────

# How many jobs one worker process handles in parallel.
# Safe to raise: correctness under parallelism comes from the atomic DB claim and the
# Redis Lua limiter, not from keeping concurrency low.
WORKER_CONCURRENCY=5

# Minimum milliseconds between two sends FROM THE SAME SENDER.
# Default 2000 (2 seconds) — the value quoted in the brief. Enforced in Redis, not
# with setTimeout, so it holds across multiple worker processes.
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Per-sender hourly ceiling. Each sender gets its own budget, so N senders give
# N x this many emails per hour in total.
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Optional tenant-wide ceiling applied on top of per-sender limits.
# Leave blank or 0 to disable and rely on per-sender limits only.
MAX_EMAILS_PER_HOUR_GLOBAL=0

# SMTP retry policy for transient failures. Permanent failures (bad address,
# authentication rejected) fail immediately without consuming these attempts.
MAX_SEND_ATTEMPTS=3
RETRY_BACKOFF_MS=30000

# How long a worker's claim on a job is honoured. A worker killed mid-send leaves a
# stale claim; the reaper returns anything older than this to SCHEDULED.
# Must comfortably exceed your slowest realistic SMTP round-trip.
JOB_LOCK_TTL_MS=120000

# How often the reconciler re-checks for drift between Postgres and Redis.
# Implemented as a self-chaining BullMQ delayed job — NOT cron.
RECONCILE_INTERVAL_MS=60000

# ── Circuit breaker ──────────────────────────────────────────────────────────
# Consecutive SMTP failures before a sender's circuit opens and traffic reroutes.
CIRCUIT_FAILURE_THRESHOLD=5
# How long a circuit stays open before a single HALF_OPEN probe is allowed through.
CIRCUIT_COOLDOWN_MS=300000
# Successful probes required to close the circuit again.
CIRCUIT_SUCCESS_THRESHOLD=2
# Sample size for the rolling failure rate that feeds the health score.
CIRCUIT_ROLLING_WINDOW=50

# ── SMTP / Ethereal ──────────────────────────────────────────────────────────
# Ethereal is a fake SMTP service: mail is accepted and rendered at a preview URL
# but never actually delivered. Create free accounts at https://ethereal.email/create
#
# `npm run db:seed` will auto-provision three Ethereal accounts via the Nodemailer
# API if you leave the block below empty — easiest path for a first run.
#
# To pin specific accounts instead, fill these in. Format per sender, index from 1:
# SMTP_1_HOST=smtp.ethereal.email
# SMTP_1_PORT=587
# SMTP_1_USER=generated.user@ethereal.email
# SMTP_1_PASS=generated_password
# SMTP_1_FROM_NAME=Outreach One
# SMTP_1_LABEL=Sender One

SMTP_AUTO_PROVISION_COUNT=3

# Connection ceiling per sender, to avoid exhausting Ethereal's limits.
SMTP_POOL_MAX_CONNECTIONS=5
SMTP_CONNECTION_TIMEOUT_MS=15000

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated CORS allowlist. There is no wildcard mode, by design.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SameSite policy for session cookies: lax | strict | none
#
# Keep 'lax' for local dev AND for any deployment where the frontend proxies /api
# to the backend (see DEPLOYMENT.md) -- that keeps everything same-origin.
#
# Only use 'none' when the browser calls the API on a genuinely different domain
# (e.g. app.vercel.app -> api.onrender.com). Browsers refuse to send a Lax cookie
# on a cross-site fetch, so users appear permanently signed out. 'none' requires
# HTTPS and makes the CSRF token the sole CSRF defence, so prefer the proxy.
COOKIE_SAMESITE=lax

# Requests per window per IP on general API routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
# Auth endpoints get a much tighter budget — they are the brute-force target.
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Max upload size for a lead file, in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760

# Require the ADMIN role to open the Bull Board queue dashboard at /admin/queues.
# Leave true. Setting false exposes queue internals to any signed-in user.
BULL_BOARD_REQUIRE_ADMIN=true

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret here.
VITE_API_URL=http://localhost:4000
